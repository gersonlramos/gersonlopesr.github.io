---
import BaseLayout from '../layouts/BaseLayout.astro';
import { experience } from '../data/experience';
---

<BaseLayout
  title="Experience — Gerson Ramos"
  description="Professional experience of Gerson Ramos across data science, machine learning, cloud data engineering, and analytics."
>
  <section class="mx-auto flex max-w-5xl flex-col gap-8 px-4 py-12 sm:py-16">
    <header class="flex max-w-3xl flex-col gap-3">
      <p class="font-mono text-sm text-accent">Career timeline</p>
      <h1 class="text-3xl font-semibold leading-tight text-foreground">Experience</h1>
      <p class="text-base leading-normal text-muted-foreground">
        A track record of turning complex data, cloud platforms, and analytical problems into
        systems that support better decisions.
      </p>
    </header>

    <ol class="flex flex-col gap-6">
      {experience.map((entry) => (
        <li class="rounded border border-border bg-surface p-6">
          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
            <h2 class="text-lg font-semibold leading-snug text-foreground">
              {entry.role} · {entry.organization}
            </h2>
            <p class="font-mono text-sm text-muted-foreground">{entry.period}</p>
          </div>
          <p class="mt-2 text-base leading-normal text-muted-foreground">{entry.context}</p>
          <ul class="mt-4 flex flex-col gap-2">
            {entry.impact.map((point) => (
              <li class="flex gap-2 text-base leading-normal text-foreground">
                <span class="text-accent" aria-hidden="true">▹</span>
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
