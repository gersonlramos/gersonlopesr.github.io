---
import BaseLayout from '../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout description="Gerson Ramos is a hybrid Data Scientist and Data Engineer with 5+ years of experience building ML, analytics, and data pipeline solutions on AWS. Explore real project case studies, experience, and how to get in touch.">
  <section
    class="mx-auto flex max-w-5xl flex-col items-center gap-4 px-4 py-12 text-center sm:py-16"
  >
    <h1 class="text-[32px] font-semibold leading-tight text-foreground">
      Gerson Ramos — Data Scientist &amp; Data Engineer
    </h1>
    <p class="max-w-2xl text-base leading-normal text-muted-foreground">
      I'm a Data Scientist and ML Developer with 5+ years of experience bridging advanced
      analytics, software engineering, and financial strategy — expert in Python and Advanced
      SQL, building Classic ML, Deep Learning, and Generative AI solutions on AWS (SageMaker,
      Bedrock, Glue), and currently architecting a large-scale GCP-to-AWS cloud migration for
      an enterprise environment. My focus is the reasoning behind each decision — why a
      particular approach, trade-off, or architecture was chosen — and the measurable business
      impact it delivered.
    </p>
    <div class="flex flex-col items-center gap-2 sm:flex-row sm:gap-4">
      <a
        href={`${baseUrl}resume.pdf`}
        download
        class="inline-flex items-center justify-center rounded bg-accent px-6 py-3 text-sm font-semibold leading-snug text-background hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent"
      >
        Download Resume (PDF)
      </a>
      <a
        href={`${baseUrl}resume-pt.pdf`}
        download
        class="inline-flex items-center justify-center rounded border border-border px-6 py-3 text-sm font-semibold leading-snug text-foreground hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent"
      >
        Baixar Currículo pt-br (PDF)
      </a>
    </div>
  </section>

</BaseLayout>
