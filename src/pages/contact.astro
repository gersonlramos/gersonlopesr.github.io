---
import BaseLayout from '../layouts/BaseLayout.astro';

const formAction = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT || 'https://formsubmit.co/gersonlopesr@gmail.com';
---

<BaseLayout
  title="Contact — Gerson Ramos"
  description="Contact Gerson Ramos about data science, machine learning, data engineering, and analytics opportunities."
>
  <section class="mx-auto grid max-w-5xl gap-10 px-4 py-12 sm:py-16 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
    <header class="flex flex-col gap-3">
      <p class="font-mono text-sm text-accent">Start a conversation</p>
      <h1 class="text-3xl font-semibold leading-tight text-foreground">Contact</h1>
      <p class="text-base leading-normal text-muted-foreground">
        Have a project, opportunity, or data problem to discuss? Send a message and I will get
        back to you.
      </p>
      <a href="mailto:gersonlopesr@gmail.com" class="mt-2 text-accent hover:underline">
        gersonlopesr@gmail.com
      </a>
    </header>

    <form action={formAction} method="POST" class="flex flex-col gap-5 rounded border border-border bg-surface p-6">
      <input type="hidden" name="_subject" value="New portfolio contact" />
      <input type="hidden" name="_captcha" value="false" />
      <div class="flex flex-col gap-2">
        <label for="name" class="text-sm font-semibold text-foreground">Name</label>
        <input id="name" name="name" type="text" required autocomplete="name" class="rounded border border-border bg-background px-3 py-3 text-foreground outline-none focus:border-accent" />
      </div>
      <div class="flex flex-col gap-2">
        <label for="email" class="text-sm font-semibold text-foreground">Email</label>
        <input id="email" name="email" type="email" required autocomplete="email" class="rounded border border-border bg-background px-3 py-3 text-foreground outline-none focus:border-accent" />
      </div>
      <div class="flex flex-col gap-2">
        <label for="message" class="text-sm font-semibold text-foreground">Message</label>
        <textarea id="message" name="message" required rows="6" class="resize-y rounded border border-border bg-background px-3 py-3 text-foreground outline-none focus:border-accent"></textarea>
      </div>
      <button type="submit" class="rounded bg-accent px-6 py-3 text-sm font-semibold text-background hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent">
        Send message
      </button>
    </form>
  </section>
</BaseLayout>
