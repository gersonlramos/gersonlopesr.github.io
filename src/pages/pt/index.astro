---
import BaseLayout from '../../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  lang="pt"
  title="Gerson Ramos — Cientista de Dados e Engenheiro de Dados"
  description="Portfólio de Gerson Ramos, Cientista de Dados e Engenheiro de Dados híbrido, com projetos reais de machine learning, analytics e engenharia de dados."
>
  <section class="mx-auto flex max-w-5xl flex-col items-center gap-4 px-4 py-12 text-center sm:py-16">
    <h1 class="text-[32px] font-semibold leading-tight text-foreground">Gerson Ramos — Cientista de Dados e Engenheiro de Dados</h1>
    <p class="max-w-2xl text-base leading-normal text-muted-foreground">
      Sou Cientista de Dados e Desenvolvedor de ML com mais de 5 anos de experiência conectando
      analytics avançado, engenharia de software e estratégia financeira. Trabalho com Python,
      SQL, Machine Learning, Deep Learning e IA generativa em AWS, com foco no raciocínio por trás
      de cada decisão e no impacto de negócio entregue.
    </p>
    <div class="flex flex-col items-center gap-2 sm:flex-row sm:gap-4">
      <a href={`${baseUrl}resume-pt.pdf`} download class="inline-flex items-center justify-center rounded bg-accent px-6 py-3 text-sm font-semibold leading-snug text-background hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent">Baixar currículo (PDF)</a>
      <a href={`${baseUrl}resume.pdf`} download class="inline-flex items-center justify-center rounded border border-border px-6 py-3 text-sm font-semibold leading-snug text-foreground hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent">Download resume (EN)</a>
    </div>
  </section>
</BaseLayout>
