---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const projects = await getCollection('projectsPt');
const featuredSlugs = ['store-sales-forecasting', 'analise-cenarios', 'finance-notes-rag'];
const featuredProjects = featuredSlugs
  .map((slug) => projects.find((project) => project.id === slug))
  .filter((project) => project !== undefined);
---

<BaseLayout lang="pt" title="Gerson Ramos — Cientista de Dados e Engenheiro de Dados" description="Gerson Ramos é Cientista de Dados e Engenheiro de Dados Cloud, construindo plataformas de dados, sistemas de ML e ferramentas de decisão em escala empresarial.">
  <section class="mx-auto grid max-w-5xl gap-10 px-4 py-16 sm:py-24 lg:grid-cols-[1.15fr_0.85fr] lg:items-end">
    <div class="flex flex-col gap-5">
      <p class="font-mono text-sm text-accent">Cientista de Dados · Engenheiro de Dados Cloud</p>
      <h1 class="max-w-3xl text-4xl font-semibold leading-tight text-foreground sm:text-5xl">Construindo plataformas de dados e sistemas de ML em escala empresarial.</h1>
      <p class="max-w-2xl text-lg leading-relaxed text-muted-foreground">Transformo problemas complexos de dados em pipelines confiáveis, modelos úteis e ferramentas que tornam decisões melhores mais fáceis de executar.</p>
      <div class="flex flex-wrap gap-3">
        <a href={`${baseUrl}projects/`} class="inline-flex items-center justify-center rounded bg-accent px-5 py-3 text-sm font-semibold text-background hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent">Explorar projetos</a>
        <a href={`${baseUrl}experience/`} class="inline-flex items-center justify-center rounded border border-border px-5 py-3 text-sm font-semibold text-foreground hover:border-accent hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent">Ver experiência</a>
      </div>
      <div class="flex flex-wrap gap-4 text-sm font-semibold">
        <a href={`${baseUrl}resume-pt.pdf`} download class="text-accent hover:underline">Baixar currículo (PT) &darr;</a>
        <a href={`${baseUrl}resume.pdf`} download class="text-muted-foreground hover:text-accent hover:underline">Download resume (EN) &darr;</a>
      </div>
    </div>
    <div class="border-l-2 border-accent pl-5 lg:mb-1"><p class="font-mono text-xs uppercase tracking-[0.2em] text-muted-foreground">Foco atual</p><p class="mt-3 text-base leading-relaxed text-foreground">Arquitetando uma migração de grande escala do GCP para a AWS enquanto construo produtos de dados que tornam a entrega visível e previsível.</p></div>
  </section>
  <section class="border-y border-border bg-surface/60"><div class="mx-auto grid max-w-5xl grid-cols-2 gap-px bg-border sm:grid-cols-4"><div class="bg-background px-4 py-6"><p class="font-mono text-3xl font-semibold text-accent">9</p><p class="mt-1 text-sm text-muted-foreground">domínios de negócio mapeados</p></div><div class="bg-background px-4 py-6"><p class="font-mono text-3xl font-semibold text-accent">3.000+</p><p class="mt-1 text-sm text-muted-foreground">objetos no escopo da migração</p></div><div class="bg-background px-4 py-6"><p class="font-mono text-3xl font-semibold text-accent">99%</p><p class="mt-1 text-sm text-muted-foreground">menos bloqueio de workers</p></div><div class="bg-background px-4 py-6"><p class="font-mono text-3xl font-semibold text-accent">1.000+</p><p class="mt-1 text-sm text-muted-foreground">tabelas processadas</p></div></div></section>
  <section class="mx-auto flex max-w-5xl flex-col gap-7 px-4 py-16 sm:py-20"><div class="flex flex-wrap items-end justify-between gap-4"><div><p class="font-mono text-sm text-accent">Trabalho selecionado</p><h2 class="mt-2 text-2xl font-semibold leading-tight text-foreground">Projetos com ponto de vista</h2></div><a href={`${baseUrl}projects/`} class="text-sm font-semibold text-accent hover:underline">Ver todos os projetos &rarr;</a></div><div class="grid grid-cols-1 gap-6 lg:grid-cols-3">{featuredProjects.map((project) => <ProjectCard project={project} lang="pt" />)}</div></section>
  <section class="mx-auto flex max-w-5xl flex-col gap-5 px-4 pb-16 sm:pb-20"><p class="font-mono text-sm text-accent">Ferramentas que utilizo</p><div class="flex flex-wrap gap-2 text-sm text-muted-foreground">{['Python', 'SQL', 'AWS', 'Snowflake', 'Apache Airflow', 'Spark', 'Machine Learning', 'IA generativa', 'Power BI'].map((tool) => <span class="rounded border border-border px-3 py-2">{tool}</span>)}</div></section>
</BaseLayout>
