---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'> | CollectionEntry<'projectsPt'>;
  lang?: 'en' | 'pt';
}

const { project, lang = 'en' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const languagePrefix = lang === 'pt' ? `${baseUrl}pt/` : baseUrl;
const categoryLabel = lang === 'pt'
  ? (project.data.category === 'data-engineering' ? 'Engenharia de Dados' : 'Ciência de Dados')
  : (project.data.category === 'data-engineering' ? 'Data Engineering' : 'Data Science');
---

<a
  href={`${languagePrefix}projects/${project.id}/`}
  class="flex flex-col gap-3 rounded border border-border bg-surface p-6 hover:border-accent"
>
  {project.data.thumbnail && (
    <img
      src={`${baseUrl}/${project.data.thumbnail.replace(/^\//, '')}`}
      alt={`${project.data.title} thumbnail`}
      width="950"
      height="541"
      loading="lazy"
      decoding="async"
      class="rounded border border-border"
    />
  )}
  <span class="w-fit rounded border border-border px-2 py-1 font-mono text-xs text-accent">{categoryLabel}</span>
  <h2 class="text-lg font-semibold leading-snug text-foreground">{project.data.title}</h2>
  <p class="text-base leading-normal text-muted-foreground">{project.data.summary}</p>
  <ul class="flex flex-wrap gap-2">
    {project.data.stack.map((tech) => (
      <li class="rounded border border-border px-2 py-1 font-mono text-xs text-accent">{tech}</li>
    ))}
  </ul>
</a>
