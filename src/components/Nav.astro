---
interface NavLink {
  label: string;
  href: string;
}

interface Props {
  lang?: 'en' | 'pt';
}

const { lang = 'en' } = Astro.props;
const homeHref = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const languagePrefix = lang === 'pt' ? `${homeHref}pt/` : homeHref;
const sitePath = homeHref === '/'
  ? Astro.url.pathname.replace(/^\/+/, '')
  : Astro.url.pathname.replace(homeHref, '').replace(/^\/+/, '');
const navLinks: NavLink[] = [
  { label: lang === 'pt' ? 'Início' : 'Home', href: languagePrefix },
  { label: lang === 'pt' ? 'Experiência' : 'Experience', href: `${languagePrefix}experience/` },
  { label: lang === 'pt' ? 'Projetos' : 'Projects', href: `${languagePrefix}projects/` },
  { label: lang === 'pt' ? 'Contato' : 'Contact', href: `${languagePrefix}contact/` },
];
const equivalentPath = lang === 'pt' ? sitePath.replace(/^pt(?:\/|$)/, '') : `pt/${sitePath}`;
const languageHref = `${homeHref}${equivalentPath}`;
const normalizedCurrentPath = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
---

<nav class="bg-surface border-b border-border px-4 py-6 sm:px-8">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-y-2">
    <a
      href={homeHref}
      class="text-[20px] font-semibold leading-tight text-foreground hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent"
    >
      Gerson Ramos
    </a>
    <ul class="flex flex-wrap justify-center gap-1 sm:gap-2">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={normalizedCurrentPath === link.href ? 'page' : undefined}
            class="inline-block rounded px-4 py-2 text-sm font-semibold leading-snug text-foreground hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent aria-[current=page]:text-accent aria-[current=page]:underline"
          >
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <a href={languageHref} class="inline-block rounded border border-border px-4 py-2 text-sm font-semibold leading-snug text-accent hover:opacity-80">{lang === 'pt' ? 'EN' : 'PT'}</a>
      </li>
    </ul>
  </div>
</nav>
